# Eleva Remote Server - Environment Variables
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL
POSTGRES_USER=eleva_admin
POSTGRES_PASSWORD=ElevaPostgres2026SecurePass!
POSTGRES_DB=eleva_remote
DATABASE_URL=postgresql://eleva_admin:ElevaPostgres2026SecurePass!@postgres:5432/eleva_remote

# Security (JWT & Admin provisioning)
JWT_SECRET=eleva-remote-jwt-secret-production-2026-key

# Domains
SERVER_HOST=desk.elevabs.com
API_HOST=https://api-remote.elevabs.com
PANEL_HOST=https://remote.elevabs.com
